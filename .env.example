# Sinapis runs with zero environment variables and needs no secret. lib/config.ts is
# the only module that reads these keys (next.config.ts also reads ADAPTER_MODE).

# Which adapter answers (source: lib/config.ts, used by lib/adapter.ts). fake answers
# from the local graph mirror; real runs Relate WASM in a browser worker with OPFS.
# Any value other than "real" means fake.
ADAPTER_MODE=fake

# Client copy of ADAPTER_MODE (source: next.config.ts sets it from ADAPTER_MODE at build
# time, lib/config.ts reads it in the browser). Leave it empty here.
NEXT_PUBLIC_ADAPTER_MODE=

# Optional override (source: lib/config.ts, read by the Relate worker). Leave empty to
# use the bundled @relate/relate-wasm package; set it to an ES module URL to load
# Relate WASM from somewhere else, for example a self-hosted build.
NEXT_PUBLIC_RELATE_WASM_URL=

# Uploaded brand images (source: next.config.ts writes it at build time, lib/config.ts
# reads it). Comma separated, for example logo,scene-1. Leave empty locally.
NEXT_PUBLIC_BRAND_FILES=

# Public site origin for absolute og:image and twitter:image URLs (source: lib/config.ts,
# used by app/layout.tsx as metadataBase). Leave empty to use https://sinapis-nine.vercel.app.
NEXT_PUBLIC_SITE_URL=
