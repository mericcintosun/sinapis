# Sinapis runs with zero environment variables. Without them it answers every
# question from lib/kitchen-graph.ts, a local mirror of the same Cypher patterns.

# URL of the @relate/relate-wasm ES module (self-hosted under /public or a CDN build
# from the Relate release page). When set, lib/relate.ts opens an OPFS store
# (opfs://sinapis-kitchen) in the browser and every matrix path, impact preview and
# write goes through Relate. This is the submission path; set it on Vercel too.
NEXT_PUBLIC_RELATE_WASM_URL=

# Written by the farm runner at build time: comma separated list of uploaded brand
# images (for example brand/logo.png,brand/scene-1.png). Leave empty locally.
NEXT_PUBLIC_BRAND_FILES=
